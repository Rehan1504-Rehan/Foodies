# ---------------------------------------------------------------------------
# FOODIES environment configuration
# Copy this file to `.env` (never commit the real `.env`) and fill in values.
#     cp .env.example .env
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Generate a new one:  python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database ---------------------------------------------------------------
# Local development falls back to SQLite when DATABASE_URL is empty.
# PostgreSQL example:
#   DATABASE_URL=postgresql://foodies:secret@localhost:5432/foodies
# Render example (use the "Internal Database URL"):
#   DATABASE_URL=postgresql://user:pass@dpg-xxxxx-a/foodies_db
DATABASE_URL=
DB_CONN_MAX_AGE=600

# --- Static / media ---------------------------------------------------------
# On Render/Railway disk-backed media only survives with a mounted volume.
MEDIA_ROOT=
STATIC_ROOT=

# --- Payments (Razorpay) ----------------------------------------------------
# Leave empty to run the built-in mock gateway (no real money moves).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Force the mock gateway even when keys are present: PAYMENTS_MOCK_MODE=True
PAYMENTS_MOCK_MODE=False

# --- Business rules (optional overrides) ------------------------------------
TAX_RATE=0.05
PLATFORM_FEE=5
DEFAULT_DELIVERY_FEE=29
FREE_DELIVERY_ABOVE=499
RESTAURANT_COMMISSION_RATE=0.15
DEFAULT_DELIVERY_EARNING=40

# --- Admin login ------------------------------------------------------------
# Credentials for Django's built-in admin at /admin/ — the ADMIN user ID is an
# alias of admin@foodies.test.  Override these in production and rotate the
# account password after setup.
ADMIN_LOGIN_ID=ADMIN
ADMIN_LOGIN_PASSWORD=Password@123

# --- Email (password reset / order mails, console backend by default) --------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FOODIES <no-reply@foodies.test>

# --- Security (production) --------------------------------------------------
SECURE_SSL_REDIRECT=True
